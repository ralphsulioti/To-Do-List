# Copy to .env and fill in the values. Load it with: uv run --env-file .env ...
# Generate a key with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# (Django's get_random_secret_key() can include $ and #, which break .env parsing.)
DJANGO_SECRET_KEY=
# 1 turns debug mode on (local development only).
DJANGO_DEBUG=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
